package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// GlobalPlatform TEE Client API, generated from libteec's tee_client_api.h
rust_bindgen {
    name: "libtee_client_api_bindgen",
    crate_name: "tee_client_api_bindgen",
    wrapper_src: "libteec_bindgen.h",
    source_stem: "bindings",
    vendor: true,
    shared_libs: ["libteec"],
    bindgen_flags: [
        "--allowlist-function=TEEC_.*",
        "--allowlist-type=TEEC_.*",
        "--allowlist-var=TEEC_.*",
    ],
}

rust_library {
    name: "libtee_optee_bindings",
    crate_name: "tee_optee_bindings",
    vendor: true,
    srcs: ["optee_bindings.rs"],
    rustlibs: ["libtee_client_api_bindgen"],
    shared_libs: ["libteec"],
}
